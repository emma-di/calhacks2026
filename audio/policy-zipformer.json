{
  "version": 1,
  "model": "zipformer",
  "cooldown_seconds": 5,
  "tuning": "ESC-50 folds 1\u20133 and designated supplemental authors only; false-positive rate <=1% on tuning cases",
  "rules": {
    "knock": {
      "labels": {
        "Knock": 1
      },
      "threshold": 0.075,
      "status": "tuned_on_source_split"
    },
    "bicycle_bell": {
      "labels": {
        "Bicycle bell": 1
      },
      "threshold": 0.05,
      "status": "disabled_source_specificity_unvalidated",
      "enabled": false
    },
    "dog_bark": {
      "labels": {
        "Bark": 1,
        "Bow-wow": 1,
        "Yip": 1,
        "Domestic animals, pets": 1
      },
      "threshold": 0.175,
      "status": "guarded_parent_fallback_exploratory_cached_and_live_reported_miss",
      "gated_labels": {
        "Dog": {
          "weight": 0.25,
          "requires_any": {
            "Bark": 0.08,
            "Bow-wow": 0.08,
            "Yip": 0.08
          }
        }
      },
      "demo_override": "TEMPORARY Emma request: classify all Domestic animals, pets as Dog barking; not evidence of actual barking."
    },
    "siren": {
      "labels": {
        "Siren": 1
      },
      "threshold": 0.225,
      "status": "tuned_on_source_split"
    },
    "smoke_alarm": {
      "labels": {
        "Smoke detector, smoke alarm": 1,
        "Fire alarm": 1
      },
      "threshold": 0.35,
      "status": "fire_and_smoke_aliases_threshold_unchanged_pending_room_validation"
    },
    "alarm_clock": {
      "labels": {
        "Alarm clock": 1
      },
      "threshold": 0.05,
      "status": "tuned_on_source_split"
    },
    "bell": {
      "labels": {
        "Bell": 1,
        "Ding": 1,
        "Chime": 1
      },
      "suppressors": {
        "Alarm clock": 0.05,
        "Smoke detector, smoke alarm": 0.35,
        "Siren": 0.225,
        "Fire alarm": 0.35
      },
      "suppressor_hold_seconds": 4,
      "threshold": 0.075,
      "status": "tuned_on_source_split"
    },
    "finger_snap": {
      "labels": {
        "Finger snapping": 1
      },
      "threshold": 0.3,
      "cooldown_seconds": 0.9,
      "status": "disabled: superseded by the camera thumbs-up; quiet snappers and loud alarms make audio snaps unreliable",
      "enabled": false
    }
  }
}
