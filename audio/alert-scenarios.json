{
 "note": "Shared timeline fixtures. tests/test_alerts.py and frontend/src/lib/alerts.test.ts both replay these against their engine. Times are milliseconds. 'expect.active' is the id of the shown event or null. 'direction' on an add step is [degrees, confidence]; 'look' resolves toward a side; 'last_reason' checks the newest decision. 'confirm' checks whether the resolve check mark is showing.",
 "scenarios": [
  {
   "name": "urgent interrupts, lower priority recorded, knock resumes only while fresh",
   "steps": [
    {
     "at": 0,
     "add": "knock",
     "id": "k1",
     "expect": {
      "reason": "displayed",
      "active": "k1"
     }
    },
    {
     "at": 1000,
     "add": "smoke_alarm",
     "id": "s1",
     "expect": {
      "reason": "interrupted",
      "replaced": "knock",
      "active": "s1",
      "queue": [
       "k1"
      ]
     }
    },
    {
     "at": 1500,
     "add": "dog_bark",
     "id": "d1",
     "expect": {
      "reason": "suppressed_lower_priority",
      "active": "s1"
     }
    },
    {
     "at": 2000,
     "dismiss": "s1",
     "expect": {
      "dismissed": true,
      "active": null,
      "confirm": true
     }
    },
    {
     "at": 2600,
     "tick": true,
     "expect": {
      "active": "k1",
      "confirm": false,
      "last_reason": "resumed_from_queue"
     }
    },
    {
     "at": 5600,
     "tick": true,
     "expect": {
      "active": null
     }
    }
   ]
  },
  {
   "name": "stale queued cue is dropped instead of replayed",
   "steps": [
    {
     "at": 0,
     "add": "smoke_alarm",
     "id": "s1",
     "expect": {
      "active": "s1"
     }
    },
    {
     "at": 100,
     "add": "knock",
     "id": "k1",
     "expect": {
      "reason": "queued",
      "queue": [
       "k1"
      ]
     }
    },
    {
     "at": 30000,
     "tick": true,
     "expect": {
      "active": null,
      "queue": []
     }
    }
   ]
  },
  {
   "name": "dismiss acknowledges an ongoing alarm; it can alert again after it stops",
   "steps": [
    {
     "at": 0,
     "add": "smoke_alarm",
     "id": "s1",
     "expect": {
      "active": "s1"
     }
    },
    {
     "at": 1000,
     "dismiss": "s1",
     "expect": {
      "dismissed": true,
      "active": null
     }
    },
    {
     "at": 3000,
     "add": "smoke_alarm",
     "id": "s2",
     "expect": {
      "reason": "acknowledged_repeat",
      "active": null
     }
    },
    {
     "at": 15000,
     "add": "smoke_alarm",
     "id": "s3",
     "expect": {
      "reason": "acknowledged_repeat",
      "active": null
     }
    },
    {
     "at": 31000,
     "add": "smoke_alarm",
     "id": "s4",
     "expect": {
      "reason": "displayed",
      "active": "s4"
     }
    }
   ]
  },
  {
   "name": "stale dismiss naming an older cue cannot clear a newer urgent cue",
   "steps": [
    {
     "at": 0,
     "add": "knock",
     "id": "k1",
     "expect": {
      "active": "k1"
     }
    },
    {
     "at": 500,
     "add": "smoke_alarm",
     "id": "s1",
     "expect": {
      "active": "s1"
     }
    },
    {
     "at": 600,
     "dismiss": "k1",
     "expect": {
      "dismissed": false,
      "active": "s1"
     }
    }
   ]
  },
  {
   "name": "repeated detections merge without restarting a nonurgent lifetime",
   "steps": [
    {
     "at": 0,
     "add": "knock",
     "id": "k1",
     "expect": {
      "active": "k1",
      "remaining": 3000,
      "sequence": 1
     }
    },
    {
     "at": 1000,
     "add": "knock",
     "id": "k2",
     "expect": {
      "reason": "merged_repeat",
      "active": "k1",
      "remaining": 2000,
      "sequence": 1
     }
    },
    {
     "at": 2500,
     "add": "knock",
     "id": "k3",
     "expect": {
      "reason": "merged_repeat",
      "active": "k1",
      "remaining": 500
     }
    },
    {
     "at": 3000,
     "tick": true,
     "expect": {
      "active": null
     }
    }
   ]
  },
  {
   "name": "an ongoing urgent sound stays visible while it continues, up to the cap",
   "steps": [
    {
     "at": 0,
     "add": "smoke_alarm",
     "id": "s1",
     "expect": {
      "active": "s1",
      "sequence": 1
     }
    },
    {
     "at": 20000,
     "add": "smoke_alarm",
     "id": "s2",
     "expect": {
      "reason": "merged_repeat",
      "active": "s1",
      "remaining": 30000,
      "sequence": 2
     }
    },
    {
     "at": 100000,
     "add": "smoke_alarm",
     "id": "s3",
     "expect": {
      "active": "s3",
      "reason": "displayed"
     }
    }
   ]
  },
