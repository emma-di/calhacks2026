  {
   "name": "a confident direction can be resolved by looking; a weak one stays undirected",
   "steps": [
    {
     "at": 0,
     "add": "knock",
     "id": "k1",
     "direction": [
      -90,
      0.9
     ],
     "expect": {
      "reason": "displayed",
      "active": "k1",
      "direction": "left"
     }
    },
    {
     "at": 500,
     "look": "right",
     "expect": {
      "resolved": false,
      "active": "k1"
     }
    },
    {
     "at": 1000,
     "look": "left",
     "expect": {
      "resolved": true,
      "active": null,
      "last_reason": "resolved_looked"
     }
    },
    {
     "at": 2000,
     "add": "knock",
     "id": "k2",
     "direction": [
      -90,
      0.9
     ],
     "expect": {
      "reason": "acknowledged_repeat",
      "active": null
     }
    },
    {
     "at": 20000,
     "add": "smoke_alarm",
     "id": "s1",
     "direction": [
      90,
      0.3
     ],
     "expect": {
      "active": "s1",
      "direction": null
     }
    },
    {
     "at": 20500,
     "look": "right",
     "expect": {
      "resolved": false,
      "active": "s1"
     }
    }
   ]
  },
